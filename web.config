<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Pass structured Next.js error responses through without IIS replacing them with generic HTML -->
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="52428800" />
        <hiddenSegments>
          <remove segment=".env" />
          <add segment=".env" />
          <remove segment=".env.local" />
          <add segment=".env.local" />
          <remove segment=".env.production" />
          <add segment=".env.production" />
        </hiddenSegments>
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
